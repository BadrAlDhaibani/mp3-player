venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# `pip install -e .` leaves this behind; the metadata lives in pyproject.toml
*.egg-info/

# PyInstaller output -- tools/build_exe.py rebuilds all of it
build/
dist/
*.spec

# tools/make_shortcut.ps1 writes one of these next to run.bat, so there is a
# console-free way to launch from the repo folder. It holds absolute paths to
# this machine's venv, so it is generated rather than committed -- same reason
# the .ico and the version resource are.
*.lnk

# A resume-input brief: the project's facts, measurements and framing guardrails,
# extracted for an LLM tailoring a CV. It is about the author rather than about
# the app, so it stays on this machine.
PORTFOLIO.md

# audio: never commit music or spike renders
*.mp3
*.wav
*.m4a
*.flac
